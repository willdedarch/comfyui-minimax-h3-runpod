# Copy values to Runpod environment variables. This file is not loaded automatically.
# Never put secrets in the image, repository or GitHub build arguments.
H3MAX_ROOT=/workspace/h3max
H3MAX_MODEL_GROUPS=h3
H3MAX_DOWNLOAD_MODELS=1
# Fill HF_TOKEN in Runpod before starting the Pod (read permission is sufficient).
# It authenticates downloads and raises applicable Hub limits, not guaranteed speed.
HF_TOKEN=
# Literal paths: Runpod does not expand ${H3MAX_ROOT} in environment values.
HF_HOME=/workspace/h3max/.cache/huggingface
HF_HUB_CACHE=/workspace/h3max/.cache/huggingface/hub
HF_XET_CACHE=/workspace/h3max/.cache/huggingface/xet
HF_ASSETS_CACHE=/workspace/h3max/.cache/huggingface/assets
HF_XET_HIGH_PERFORMANCE=1
HF_XET_CHUNK_CACHE_SIZE_BYTES=0
HF_HUB_DOWNLOAD_TIMEOUT=120
HF_HUB_ETAG_TIMEOUT=30
HF_HUB_DISABLE_TELEMETRY=1
# Optional text compiler; disabled until its endpoint is configured.
H3IR_LLM_URL=
H3IR_LLM_MODEL=
H3IR_LLM_KEY=
# Extra ComfyUI arguments as JSON array, no shell interpretation.
H3MAX_COMFY_ARGS=[]
